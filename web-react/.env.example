# Copy to .env; change values for your Linux LAN server.
IMAGE=wake-my-pc-web:local
# For a registry image, set IMAGE to your published image and tag.
# IMAGE=ghcr.io/your-account/wake-my-pc-web:latest
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://localhost:8787
# Recommended if the server has multiple adapters. Use the server's LAN IP, not the target PC.
# LAN_IP=192.168.0.10

# To access directly from another LAN device (HTTP; camera/Agent crypto require HTTPS):
# HOST=0.0.0.0
# PUBLIC_ORIGIN=http://192.168.0.10:8787

# With an HTTPS reverse proxy running on the same server:
# HOST=127.0.0.1
# PUBLIC_ORIGIN=https://wake.home.arpa
